{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["OPENCODE.md"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "bash -n *": "allow",
      "bash plugins/supergraph/tests/*": "allow",
      "bash *test*.sh*": "allow",
      "sh *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "node *": "allow",
      "nodemon *": "allow",
      "ts-node *": "allow",
      "pm2 *": "allow",
      "lsof -i :3000*": "allow",
      "lsof -i :3001*": "allow",
      "lsof -i :4000*": "allow",
      "lsof -i :5000*": "allow",
      "lsof -i :8000*": "allow",
      "lsof -i :8080*": "allow",
      "lsof -i :5173*": "allow",
      "lsof -ti:3000*": "allow",
      "lsof -ti:4000*": "allow",
      "lsof -ti:5000*": "allow",
      "kill -9 $(lsof -ti:3000*": "allow",
      "kill -9 $(lsof -ti:4000*": "allow",
      "kill -9 $(lsof -ti:5000*": "allow",
      "kill *3000*": "allow",
      "kill *4000*": "allow",
      "kill *5000*": "allow",
      "kill *8000*": "allow",
      "kill *8080*": "allow",
      "fuser -k 3000*": "allow",
      "fuser -k 4000*": "allow",
      "fuser -k 5000*": "allow",
      "fuser -k 8000*": "allow",
      "fuser -k 8080*": "allow",
      "npx kill-port 3000*": "allow",
      "npx kill-port 4000*": "allow",
      "npx kill-port 5000*": "allow",
      "npx kill-port 8000*": "allow",
      "npx kill-port 8080*": "allow",
      "pkill -f node*": "allow",
      "netstat *": "allow",
      "ss *": "allow",
      "ps aux*": "allow",
      "make *": "allow",
      "composer *": "allow",
      "php *": "allow",
      "dart *": "allow",
      "flutter *": "allow",
      "fvm *": "allow",
      "go *": "allow",
      "cargo *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "vendor/bin/*": "allow",
      "gofmt *": "allow",
      "golangci-lint *": "allow",
      "playwright *": "allow",
      "npx playwright*": "allow",
      "python -m playwright*": "allow",
      "python scripts/with_server.py*": "allow",
      "python *test*.py*": "allow",
      "pip install*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "mkfs *": "deny",
      "dd if=*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny"
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [],
      "enabled": true
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": ["start-mcp-server", "--context=opencode", "--project-from-cwd"],
      "enabled": true
    }
  }
}
