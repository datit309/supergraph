{
  "supergraph": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/run-hook.cmd pre-invocation"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-hook.cmd pre-tool-use"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-hook.cmd bash-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-hook.cmd post-tool-use"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-hook.cmd post-tool-use-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/run-hook.cmd stop"
      }
    ]
  }
}
