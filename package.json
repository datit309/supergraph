{
  "name": "supergraph",
  "version": "2.3.0",
  "description": "Supergraph workflow, skills, and MCP tools for DeepSeek Harness (DSH)",
  "type": "module",
  "main": "./plugins/supergraph/index.js",
  "exports": {
    ".": "./plugins/supergraph/index.js",
    "./client": "./plugins/supergraph/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "sg-team-mcp": "./plugins/supergraph/bin/sg-team-mcp.js",
    "sg-team-ui": "./plugins/supergraph/bin/sg-team-ui.js",
    "sg-team-status": "./plugins/supergraph/bin/sg-team-status.js",
    "sg-browser-mcp": "./plugins/supergraph/bin/sg-browser-mcp.js"
  },
  "scripts": {
    "test": "node --test plugins/supergraph/tests/*.mjs"
  },
  "files": [
    "plugins/supergraph",
    "AGENTS.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./plugins/supergraph/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "supergraph",
    "dsh",
    "deepseek-harness",
    "codebase-memory",
    "serena",
    "workflow",
    "tdd"
  ],
  "author": {
    "name": "datit309",
    "email": "trantandat0919@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/datit309/supergraph",
  "repository": {
    "type": "git",
    "url": "https://github.com/datit309/supergraph.git"
  },
  "dependencies": {
    "agent-browser": "^0.39.1"
  }
}
